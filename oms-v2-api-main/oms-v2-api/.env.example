#App
NODE_ENV=development
PORT=4000
TYPEORM_SYNCHRONIZE=true
REDIS_ACTIVE=true

JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d

SWAGGER_USER=admin
SWAGGER_PASSWORD=your_swagger_password
SWAGGER_API_END_POINT=api/docs

## DB Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=oms_v2

MONGODB_URI=mongodb://localhost:27017/oms_v2

#AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1
AWS_BUCKET=your_aws_bucket_name
ASSETS_URL=http://localhost:4000
ASSETS_DIR='tmp_aws_media'
AWS_S3_DEFAULT_FOLDER=tmp_aws_media

# Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=your_smtp_password

# Test Mail Configuration
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_FROM_NAME=OMS ERP
MAIL_FROM_EMAIL=noreply@example.com
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=oms-service
KAFKA_EMAIL_TOPIC=email-topic

# Prometheus metrics endpoint
PROMETHEUS_PORT=4000

# Google Map
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# CloudFlare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_HASH=your_cloudflare_account_hash

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@example.com
FIREBASE_PRIVATE_KEY=""

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_UNIQUE_ID=we_test_webhook_id
STRIPE_WEBHOOK_SIGNING_SECRET_LOCAL=whsec_your_local_signing_secret
STRIPE_WEBHOOK_SIGNING_SECRET_STAGING=whsec_your_staging_signing_secret

# Logger
DEBUG=info
USE_JSON_LOGGER=false
SENTRY_DNS=

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/oauth/callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/oauth/callback

FRONTEND_URL=http://localhost:3000

# Google Calendar / Meet (separate OAuth from login)
GOOGLE_MEET_CLIENT_ID=your_google_meet_client_id
GOOGLE_MEET_CLIENT_SECRET=your_google_meet_client_secret
GOOGLE_MEET_CALLBACK_URL=http://localhost:4000/api/v1/meetings/google/callback
