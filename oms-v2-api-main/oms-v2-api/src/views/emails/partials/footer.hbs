<!-- Footer -->
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; margin-top: 32px;">
  <tr>
    <td style="border-top: 1px solid #e5e7eb; padding-top: 24px; padding-bottom: 24px; text-align: center; font-family: Arial, Helvetica, sans-serif;">

      <p style="margin: 0 0 8px 0; font-size: 12px; color: #6b7280; line-height: 1.5; font-family: Arial, Helvetica, sans-serif;">
        Need help? Contact us at
        <a href="mailto:{{supportEmail}}"
           style="color: #3b82f6; text-decoration: none;">
          {{supportEmail}}
        </a>
      </p>

      <p style="margin: 0 0 4px 0; font-size: 12px; color: #6b7280; line-height: 1.5; font-family: Arial, Helvetica, sans-serif;">
        © {{currentYear}} {{companyName}}. All rights reserved.
      </p>

      <p style="margin: 0; font-size: 12px; color: #6b7280; line-height: 1.5; font-family: Arial, Helvetica, sans-serif;">
        {{companyAddress}}
      </p>

    </td>
  </tr>
</table>