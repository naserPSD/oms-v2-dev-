<!-- Header -->
<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background-color: #ffffff; border-radius: 8px 8px 0 0;
              border-collapse: collapse;
              border-bottom: 1px solid #e5e7eb;">
  <tr>
    <td style="padding: 24px 24px 16px 24px; text-align: center; font-family: Arial, Helvetica, sans-serif;">

      {{#if companyLogoUrl}}
        <img
          src="{{companyLogoUrl}}"
          alt="Company Logo"
          style="height: 44px; width: auto; display: block; margin: 0 auto 12px auto;"
        />
      {{else}}
        <img
          src="https://sanzio.app/images/sanzio-logo.png"
          alt="Sanzio Logo"
          style="height: 44px; width: auto; display: block; margin: 0 auto 12px auto;"
        />
      {{/if}}

      <h1 style="margin: 0; font-size: 24px; font-weight: 700; color: #2563eb; font-family: Arial, Helvetica, sans-serif;">
        {{headerTitle}}
      </h1>

    </td>
  </tr>
</table>