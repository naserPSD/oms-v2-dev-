<p style="font-size: 18px; font-weight: 600; margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">Hi,</p>

<p style="margin: 0 0 16px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  You have been invited to join <strong style="color: #1f2937;">{{applicationName}}</strong>.
</p>

<p style="margin: 0 0 16px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  <strong style="color: #1f2937;">{{officeName}},</strong><br/>
  <span>{{email}}</span><br/>
  <span style="font-style: normal; display: block; margin-top: 4px;">{{{officeAddress}}}</span>
</p>

<p style="margin: 0 0 24px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  To get started, please click the button below to see your invitation and Sign Up.
</p>

<!-- Bulletproof CTA Button -->
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 32px 0; border-collapse: collapse;">
  <tr>
    <td align="left" style="font-family: Arial, Helvetica, sans-serif;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
        <tr>
          <td align="center" bgcolor="#22c55e" style="border-radius: 6px; background-color: #22c55e;">
            <a href="{{invitationLink}}"
               target="_blank"
               style="display: inline-block; padding: 12px 28px; font-family: Arial, Helvetica, sans-serif; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none; border-radius: 6px; background-color: #22c55e; border: 1px solid #22c55e;">
              See Invitation
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 4px 0; color: #1f2937; font-weight: 600; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">{{emailClosingNote}}</p>
<p style="margin: 0; color: #4b5563; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">{{supportTeamName}}</p>