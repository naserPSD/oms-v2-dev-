<p style="font-size: 18px; font-weight: 600; margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
  Hello {{name}},
</p>

<p style="margin: 0 0 24px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  You have been assigned to an upcoming interview schedule. Please review the details below:
</p>

<!-- Details Table -->
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0; border-collapse: collapse;">
  <tbody>
  {{#if scheduleDatetime}}
    <tr>
      <td width="35%" style="padding: 12px; border: 1px solid #e5e7eb; background-color: #f9fafb; font-weight: 600; color: #1f2937; font-family: Arial, Helvetica, sans-serif; font-size: 15px;">
        Date &amp; Time
      </td>
      <td style="padding: 12px; border: 1px solid #e5e7eb; color: #374151; font-family: Arial, Helvetica, sans-serif; font-size: 15px;">
        {{scheduleDatetime}}
      </td>
    </tr>
  {{/if}}

  {{#if interviewLocation}}
    <tr>
      <td width="35%" style="padding: 12px; border: 1px solid #e5e7eb; background-color: #f9fafb; font-weight: 600; color: #1f2937; font-family: Arial, Helvetica, sans-serif; font-size: 15px;">
        Location / Meeting Link
      </td>
      <td style="padding: 12px; border: 1px solid #e5e7eb; color: #374151; font-family: Arial, Helvetica, sans-serif; font-size: 15px;">
        {{#if isUrl}}
          <a href="{{interviewLocation}}" target="_blank" style="color: #3b82f6; text-decoration: underline; font-weight: 600;">
            Click here to join the interview
          </a>
        {{else}}
          {{interviewLocation}}
        {{/if}}
      </td>
    </tr>
  {{/if}}
  </tbody>
</table>

<p style="margin: 0 0 16px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  Please log in to the recruitment portal to view the applicant's details, download their CV, and access the evaluation grading panel for this interview.
</p>

<p style="margin: 0 0 32px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  If you have any questions or scheduling conflicts, please reach out to the HR department or contact us at
  <a href="mailto:{{supportEmail}}" style="color: #3b82f6; text-decoration: none;">{{supportEmail}}</a>.
</p>

<p style="margin: 0 0 4px 0; color: #1f2937; font-weight: 600; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  {{emailClosingNote}}
</p>
<p style="margin: 0; color: #4b5563; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  <strong style="color: #1f2937;">{{supportTeamName}}</strong><br>
  {{companyName}}
</p>