<p style="font-size: 18px; font-weight: 600; margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
  Hi {{name}},
</p>

<p style="margin: 0 0 16px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  Your password has been changed successfully.
</p>

<p style="margin: 0 0 24px 0; color: #374151; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">
  If you did not change your password, then please reset your password immediately.
</p>

<!-- Bulletproof CTA Button -->
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0; border-collapse: collapse;">
  <tr>
    <td align="center" style="font-family: Arial, Helvetica, sans-serif;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
        <tr>
          <td align="center" bgcolor="#3b82f6" style="border-radius: 6px; background-color: #3b82f6;">
            <a href="{{resetLink}}"
               target="_blank"
               style="display: inline-block; padding: 10px 24px; font-family: Arial, Helvetica, sans-serif; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none; border-radius: 6px; background-color: #3b82f6; border: 1px solid #3b82f6;">
              Reset Password
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 4px 0; color: #1f2937; font-weight: 600; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">{{emailClosingNote}}</p>
<p style="margin: 0; color: #4b5563; font-family: Arial, Helvetica, sans-serif; line-height: 1.5;">{{supportTeamName}}</p>